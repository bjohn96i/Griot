{
  "document": {
    "block_prefix": "\n",
    "block_suffix": "\n",
    "color": "#C7D3E8",
    "background_color": "#000000",
    "margin": 2
  },
  "block_quote": { "color": "#8FA3C7", "indent": 1, "indent_token": "│ " },
  "paragraph": {},
  "list": { "color": "#C7D3E8", "level_indent": 2 },
  "heading": { "color": "#E3B341", "bold": true, "block_suffix": "\n" },
  "h1": { "prefix": " ", "suffix": " ", "color": "#000000", "background_color": "#E3B341" },
  "h2": { "prefix": "◆ " },
  "h3": { "prefix": "◈ " },
  "h4": { "prefix": "· " },
  "h5": { "prefix": "· " },
  "h6": { "prefix": "· " },
  "strong": { "color": "#F0C75E", "bold": true },
  "emph": { "color": "#F0C75E", "italic": true },
  "hr": { "color": "#1E3A5F", "format": "\n────────────────────\n" },
  "item": { "block_prefix": "• " },
  "enumeration": { "block_prefix": ". " },
  "task": { "ticked": "✓ ", "unticked": "○ " },
  "link": { "color": "#4EC97B", "underline": true },
  "link_text": { "color": "#E3B341" },
  "code": { "color": "#F0C75E", "background_color": "#0D1526" },
  "code_block": {
    "color": "#C7D3E8",
    "background_color": "#0D1526",
    "margin": 2,
    "chroma": {
      "text": { "color": "#C7D3E8" },
      "keyword": { "color": "#E3B341" },
      "literal_string": { "color": "#4EC97B" },
      "comment": { "color": "#8FA3C7" },
      "name_function": { "color": "#F0C75E" }
    }
  },
  "table": { "center_separator": "┼", "column_separator": "│", "row_separator": "─" }
}
