#!/usr/bin/env bash
# griot-capture — quick capture (⌥c). Type a line; it's handed to Griot via
# /griot:capture in a new center tab so Griot files it per the schema.
# Invoked from a tmux display-popup.
set -euo pipefail

HERE="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
CENTER="griot-center"

printf '\033[1;33m ✎ Griot capture \033[0m — file a thought into the vault\n\n'
if [[ "${1:-}" == "--line" && -n "${2:-}" ]]; then
  line="$2"                       # non-interactive (testing)
else
  read -r -p "capture > " line || exit 0
fi
[[ -z "${line// }" ]] && exit 0

CLAUDE_DIR="$(uv run --project "$HERE" python -c \
  'from griot.config import load_config; print(load_config().claude_default_dir)' \
  2>/dev/null)"

prompt="/griot:capture $line"
exec tmux -L griot new-window -t "$CENTER" -n capture -c "$CLAUDE_DIR" \
  "claude $(printf '%q' "$prompt"); exec $SHELL"
