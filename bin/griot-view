#!/usr/bin/env bash
# griot-view <note-path> — render a vault note with the Vibranium style.
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
STYLE="$HERE/generated/glow.json"
# Rendered by the launcher; regenerate if missing (e.g. griot-view run standalone).
[[ -f "$STYLE" ]] || uv run --project "$HERE" griot-theme --generate >/dev/null

if [[ $# -lt 1 || ! -f "${1:-}" ]]; then
  echo "usage: griot-view <note-path>" >&2
  exit 1
fi

if ! command -v glow >/dev/null; then
  echo "glow not installed — brew install glow" >&2
  exit 1
fi

exec glow --pager --style "$STYLE" --width 100 "$1"
