Screen {
    background: $bg;
    color: $text;
}
DataTable {
    background: $bg;
    color: $text;
}
DataTable > .datatable--cursor {
    background: $select;
    color: $accent_bright;
}
DataTable > .datatable--header {
    background: $panel;
    color: $accent;
}
.panel {
    background: $panel;
    border: round $outline;
    color: $text;
    padding: 0 1;
    margin: 0 0 1 0;
}
.panel-title {
    background: $chrome;
    color: $accent;
    text-style: bold;
}

/* Docked key hints. Lives on chrome, so it needs chrome's foreground. */
.pane-footer {
    dock: bottom;
    height: 1;
    background: $chrome;
    color: $chrome_text;
}
.stale {
    color: $muted;
}
.status-err {
    color: $err;
}
.status-ok {
    color: $ok;
}

TaskDetailScreen {
    background: $bg;
}
.detail-title {
    background: $chrome;
    color: $chrome_text;
    padding: 0 1;
    height: 1;
}
.detail-chips {
    padding: 0 1;
    height: 1;
    margin: 1 0 0 0;
}
#detail-scroll {
    background: $bg;
    margin: 1 0 0 0;
}
#detail-body {
    background: $bg;
    color: $text;
    padding: 0 1;
}
Markdown {
    background: $bg;
}
.detail-footer {
    dock: bottom;
    height: 1;
    background: $chrome;
    color: $chrome_text;
}

#status-scroll {
    background: $bg;
    height: 1fr;
}

OptionList {
    background: $bg;
    border: none;
    padding: 0;
    height: 1fr;
}
OptionList > .option-list--option {
    padding: 0 1;
}
OptionList > .option-list--option-highlighted {
    background: $select;
}
OptionList:focus > .option-list--option-highlighted {
    background: $select;
    color: $accent_bright;
}
